{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Preparar Minimini Bot",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/vscode-prepare.sh"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoLogo",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\scripts\\vscode-prepare.ps1"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      }
    }
  ]
}
