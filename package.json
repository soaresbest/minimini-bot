{
  "name": "minimini-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Bots Minecraft gerenciados pelo chat, com comandos diretos e IA.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --disable-warning=DEP0040 src/index.js",
    "configure": "node --disable-warning=DEP0040 src/index.js --configure",
    "check": "node scripts/check.js",
    "test": "node --disable-warning=DEP0040 --test",
    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "minecraft-data": "3.117.0",
    "minecraft-protocol": "1.68.0",
    "mineflayer": "4.39.0",
    "mineflayer-pathfinder": "2.4.5"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
